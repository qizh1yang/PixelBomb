[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/Lobby/sub/room_card.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
bg_color = Color(0.1725, 0.2118, 0.1922, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.2745, 0.3216, 0.2824, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_join_btn"]
bg_color = Color(0.4863, 0.6235, 0.6902, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_join_hover"]
bg_color = Color(0.4377, 0.5611, 0.6212, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="RoomCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 110)
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 80.0
grow_horizontal = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="HBox" type="HBoxContainer" parent="Margin"]
layout_mode = 2

[node name="InfoVBox" type="VBoxContainer" parent="Margin/HBox"]
layout_mode = 2
size_flags_horizontal = 3
alignment = 1

[node name="TopHBox" type="HBoxContainer" parent="Margin/HBox/InfoVBox"]
layout_mode = 2

[node name="RoomID" type="Label" parent="Margin/HBox/InfoVBox/TopHBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.753, 0.223, 0.168, 1)
theme_override_font_sizes/font_size = 24
text = "#A3F7"

[node name="Spacer" type="Control" parent="Margin/HBox/InfoVBox/TopHBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="PlayerCount" type="Label" parent="Margin/HBox/InfoVBox/TopHBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.7216, 0.698, 0.6549, 1)
theme_override_font_sizes/font_size = 20
text = "2/4 人"

[node name="BottomHBox" type="HBoxContainer" parent="Margin/HBox/InfoVBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="HostName" type="Label" parent="Margin/HBox/InfoVBox/BottomHBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.7216, 0.698, 0.6549, 1)
theme_override_font_sizes/font_size = 18
text = "队长：暗影猎手"

[node name="StatusLabel" type="Label" parent="Margin/HBox/InfoVBox/BottomHBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.9059, 0.8863, 0.8471, 1)
theme_override_font_sizes/font_size = 18
text = "● 等待中"

[node name="Control" type="Control" parent="Margin/HBox"]
custom_minimum_size = Vector2(20, 0)
layout_mode = 2

[node name="JoinBtn" type="Button" parent="Margin/HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 52)
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_styles/normal = SubResource("StyleBoxFlat_join_btn")
theme_override_styles/hover = SubResource("StyleBoxFlat_join_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_join_btn")
text = "加入任务"

[connection signal="pressed" from="Margin/HBox/JoinBtn" to="." method="_on_join_btn_pressed"]
